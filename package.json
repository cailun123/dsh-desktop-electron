{
  "name": "dsh-desktop-electron",
  "description": "Electron desktop shell for the DeepSeek Harness Web GUI: spawns dsh web and hosts it in a standalone window with tray residency",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "dev": "npm run build && node scripts/run-electron.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:electron:windows": "npm run build && node scripts/smoke-windows-shim.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --config electron-builder.yml --dir && npm run verify:package",
    "verify:package": "node scripts/verify-packaged-closure.mjs"
  },
  "dependencies": {
    "cross-spawn": "7.0.6"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^22.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
